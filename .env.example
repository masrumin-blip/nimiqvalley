# Public values — safe to share. They only identify the backend and allow
# browser access that is limited by database access rules.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Private values — never commit these. Set them in your hosting provider's
# secret storage (in Lovable: Settings, Secrets).
# SESSION_SECRET="a-random-string-of-at-least-32-characters"
